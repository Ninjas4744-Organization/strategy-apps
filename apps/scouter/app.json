{
  "expo": {
    "name": "The Ninja Scouter",
    "slug": "scouting",
    "version": "0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ninjascouter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/NinjasAppIcon.icon",
      "bundleIdentifier": "com.realKfiros.scoutingApp",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "package": "com.ninjas4744.scouter"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-notifications",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ab6c91a9-4edc-4b9a-b50f-032b69ac1395"
      },
      "forceRTL": false,
      "supportsRTL": false
    },
    "runtimeVersion": "0.5",
    "updates": {
      "url": "https://u.expo.dev/ab6c91a9-4edc-4b9a-b50f-032b69ac1395"
    }
  }
}
