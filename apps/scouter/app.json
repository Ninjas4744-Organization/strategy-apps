{
	"expo": {
		"name": "The Ninja Scouter",
		"slug": "scouting",
		"version": "0.4",
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"scheme": "ninjascouter",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"icon": "./assets/NinjasAppIcon.icon",
			"bundleIdentifier": "com.realKfiros.scoutingApp",
			"infoPlist": {
				"ExpoLocalization_supportsRTL": false,
				"NSBluetoothAlwaysUsageDescription": "This app uses Bluetooth for nearby scouting coordination",
				"NSBluetoothPeripheralUsageDescription": "This app uses Bluetooth to broadcast scouting status"
			}
		},
		"android": {
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.ninjas4744.scouter",
			"permissions": [
				"android.permission.BLUETOOTH",
				"android.permission.BLUETOOTH_ADMIN",
				"android.permission.BLUETOOTH_ADVERTISE",
				"android.permission.BLUETOOTH_SCAN",
				"android.permission.BLUETOOTH_CONNECT",
				"android.permission.ACCESS_FINE_LOCATION",
				"android.permission.ACCESS_COARSE_LOCATION"
			]
		},
		"web": {
			"bundler": "metro",
			"favicon": "./assets/favicon.png"
		},
		"plugins": [
			"expo-router",
			"expo-font",
			"expo-localization",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#ffffff"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "ab6c91a9-4edc-4b9a-b50f-032b69ac1395"
			},
			"forceRTL": false,
			"supportsRTL": false
		},
		"runtimeVersion": "0.4",
		"updates": {
			"url": "https://u.expo.dev/ab6c91a9-4edc-4b9a-b50f-032b69ac1395"
		}
	},
	"submit": {
		"production": {
			"ios": {
				"ascAppId": "6753592050"
			}
		}
	}
}
