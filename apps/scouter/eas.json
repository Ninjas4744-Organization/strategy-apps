{
	"cli": {
		"version": ">= 13.1.1",
		"appVersionSource": "remote"
	},
	"build": {
		"simulator": {
			"channel": "development",
			"ios": {
				"simulator": true
			}
		},
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"channel": "development"
		},
		"preview": {
			"distribution": "internal",
			"channel": "preview"
		},
		"production": {
			"autoIncrement": true,
			"channel": "master",
			"android": {
				"buildType": "apk"
			}
		}
	},
	"submit": {
		"production": {}
	}
}
