rules_version = '2';
service cloud.firestore {
	match /databases/{database}/documents {
		function isSignedIn() {
			return request.auth != null;
		}

		function isAppAdmin() {
			return isSignedIn()
				&& exists(/databases/$(database)/documents/users/$(request.auth.uid))
				&& get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'app_admin';
		}

		function userData() {
			return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
		}

		function isRegisteredUser() {
			return isSignedIn()
				&& exists(/databases/$(database)/documents/users/$(request.auth.uid));
		}

		function isTeamAdmin() {
			return isRegisteredUser()
				&& userData().type == 'team_admin';
		}

		function isNonAnonymous() {
			return isSignedIn()
				&& request.auth.token.firebase.sign_in_provider != 'anonymous';
		}

		function isSameTeam(teamNumber) {
			return isRegisteredUser()
				&& userData().team == teamNumber;
		}

		function targetUserData(userId) {
			return get(/databases/$(database)/documents/users/$(userId)).data;
		}

		function targetUserExists(userId) {
			return exists(/databases/$(database)/documents/users/$(userId));
		}

		function isActiveEvent(eventId) {
			return exists(/databases/$(database)/documents/events/$(eventId))
				&& (
					!get(/databases/$(database)/documents/events/$(eventId)).data.keys().hasAny(['active'])
					|| get(/databases/$(database)/documents/events/$(eventId)).data.active == true
				);
		}

		function isActiveForEvent(eventId) {
			return isRegisteredUser()
				&& exists(/databases/$(database)/documents/events/$(eventId)/activeUsers/$(request.auth.uid))
				&& get(/databases/$(database)/documents/events/$(eventId)/activeUsers/$(request.auth.uid)).data.active == true;
		}

		function canWriteReports(eventId) {
			return isNonAnonymous()
				&& isActiveEvent(eventId)
				&& isActiveForEvent(eventId);
		}

		function isAssignmentOwner() {
			return isRegisteredUser()
				&& resource.data.keys().hasAll(['scouter_id'])
				&& resource.data.scouter_id == request.auth.uid;
		}

		function hasAssignmentTeam() {
			return resource.data.keys().hasAll(['owning_team']);
		}

		function isCreatingOwnTeamAssignment() {
			return isTeamAdmin()
				&& isSameTeam(request.resource.data.owning_team)
				&& request.resource.data.created_by == request.auth.uid
				&& request.resource.data.keys().hasOnly([
					'owning_team',
					'team_number',
					'match_number',
					'scouter_id',
					'scouter_name',
					'created_by',
					'created_at',
					'updated_at',
					'notified_at',
					'last_nexus_status',
					'nexus_data_as_of_time',
					'notification_result',
					'notification_error',
				])
				&& request.resource.data.match_number is string
				&& request.resource.data.team_number is string
				&& request.resource.data.notified_at == null
				&& request.resource.data.last_nexus_status == null
				&& request.resource.data.nexus_data_as_of_time == null
				&& request.resource.data.notification_result == null
				&& request.resource.data.notification_error == null;
		}

		function isUpdatingOwnTeamAssignment() {
			return isTeamAdmin()
				&& hasAssignmentTeam()
				&& isSameTeam(resource.data.owning_team)
				&& request.resource.data.owning_team == resource.data.owning_team
				&& request.resource.data.created_by == resource.data.created_by
				&& request.resource.data.diff(resource.data).affectedKeys().hasOnly([
					'team_number',
					'match_number',
					'scouter_id',
					'scouter_name',
					'updated_at',
					'notified_at',
					'last_nexus_status',
					'nexus_data_as_of_time',
					'notification_result',
					'notification_error',
				])
				&& request.resource.data.match_number is string
				&& request.resource.data.team_number is string
				&& request.resource.data.notified_at == null
				&& request.resource.data.last_nexus_status == null
				&& request.resource.data.nexus_data_as_of_time == null
				&& request.resource.data.notification_result == null
				&& request.resource.data.notification_error == null;
		}

		// Allow only app admins to manage registration codes.
		match /registration_codes/{teamId} {
			allow read: if true;
			allow write: if isAppAdmin();
		}

		match /nexusEventStates/{eventId} {
			allow read, write: if isAppAdmin();
		}

    // Allow read/write access to users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isNonAnonymous();

			match /messagingTokens/{tokenId} {
				allow read: if isSignedIn() && (request.auth.uid == userId || isAppAdmin());
				allow create, update: if isSignedIn()
					&& request.auth.uid == userId
					&& isNonAnonymous()
					&& request.resource.data.token is string
					&& request.resource.data.disabled_at == null;
				allow delete: if isSignedIn()
					&& request.auth.uid == userId
					&& isNonAnonymous();
			}
    }

    // Allow reading and writing to the "teams" collection
    match /teams/{teamId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';

      // Allow subcollection access like /teams/{teamId}/games/{gameId}
      match /games/{gameId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }

    // Allow reading and writing to the "events" collection
    match /events/{eventId} {
    	allow read: if true;
      allow create: if isAppAdmin();
      allow update: if isAppAdmin();
      allow delete: if isAppAdmin();

			match /activeUsers/{userId} {
				allow read: if isRegisteredUser()
					|| isAppAdmin()
					|| (isSignedIn() && request.auth.uid == userId)
					|| (
						isTeamAdmin()
						&& targetUserExists(userId)
						&& isSameTeam(targetUserData(userId).team)
					);
				allow create, update: if isAppAdmin()
					|| (
						isTeamAdmin()
						&& targetUserExists(userId)
						&& isSameTeam(targetUserData(userId).team)
						&& request.resource.data.keys().hasOnly([
							'active',
							'team',
							'user_name',
							'user_type',
							'updated_by',
							'updated_at',
						])
						&& request.resource.data.active is bool
						&& request.resource.data.team == targetUserData(userId).team
						&& request.resource.data.user_type == targetUserData(userId).type
						&& request.resource.data.updated_by == request.auth.uid
					);
				allow delete: if isAppAdmin()
					|| (
						isTeamAdmin()
						&& targetUserExists(userId)
						&& isSameTeam(targetUserData(userId).team)
					);
			}

			match /assignments/{assignmentId} {
				allow read: if isAppAdmin()
					|| (isTeamAdmin() && hasAssignmentTeam() && isSameTeam(resource.data.owning_team))
					|| isAssignmentOwner();
				allow create: if isCreatingOwnTeamAssignment() || isAppAdmin();
				allow update: if isUpdatingOwnTeamAssignment() || isAppAdmin();
				allow delete: if isAppAdmin()
					|| (isTeamAdmin() && hasAssignmentTeam() && isSameTeam(resource.data.owning_team));
			}

      // Allow reading and writing to the "teams" collection
    	match /teams/{teamId} {
      	allow read: if true;
        allow write: if canWriteReports(eventId);

      	// Allow subcollection access like /teams/{teamId}/games/{gameId}
      	match /games/{gameId} {
        	allow read: if true;
          allow write: if canWriteReports(eventId);
      	}
    	}
      // Allow reading and writing to the "pit" collection
      match /pit/{teamId} {
				allow read: if true;
        allow write: if canWriteReports(eventId);
      }
    }
  }
}
